# ==============================================================================
# Copy to .env.local for local dev. Add the same names on Vercel → Settings → Environment Variables.
# ==============================================================================

# REQUIRED on Vercel for database (Supabase → Settings → Database → Connection string → URI → pooling ON)
# Use port 6543 pooler URL for the live Next.js app on Vercel.
POSTGRES_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# OPTIONAL — admin product image uploads (Vercel → Storage → Blob → token)
# If missing, admin saves still work but may use a placeholder image.
BLOB_READ_WRITE_TOKEN=""

# OPTIONAL — lock /admin in production if you wire Basic Auth or similar (see VERCEL_DEPLOY.md)
ADMIN_USER=""
ADMIN_PASSWORD=""

# OPTIONAL — used for absolute links / SEO when you set it
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
