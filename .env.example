# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env.local and fill in the values
# ==============================================================================

# 1. Database Connection (Supabase PostgreSQL / Vercel Postgres)
# Replace with your Supabase Transaction pooling connection string or Vercel Postgres string
POSTGRES_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
POSTGRES_PRISMA_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. Supabase Integration Keys (Authentication & Direct API Access)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 3. Storage Config (Vercel Blob or Supabase Storage)
# Required if using Vercel Blob for zero-config uploads
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_secret_token"

# 4. App URL / Site Setup
NEXT_PUBLIC_SITE_URL="https://knitsbymuna.vercel.app"
